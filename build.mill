package build
import mill._, scalalib._, scalajslib._

object pi extends ScalaJSModule {
  def jvmVersion = "25"
  def scalaVersion = "3.10.0"
  def scalaJSVersion = "1.22.0"

  def mvnDeps = Seq(
    mvn"org.scala-js::scalajs-dom::2.8.1"
  )

  object test extends ScalaJSTests, TestModule.Utest {
    override def scalaJSTestDeps = Task {
      // Mill 1.3.0 prepends a Scala 2.13 standard library from the test bridge.
      // Use the app's Scala 3.10 standard library already on runClasspath.
      super.scalaJSTestDeps().filterNot(_.path.last.startsWith("scalajs-scalalib_"))
    }

    def mvnDeps = Seq(mvn"com.lihaoyi::utest::0.9.5")
  }
}
